TERM_DB_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://terms:replace-with-random-password@127.0.0.1:55432/terms
MCP_HOST=0.0.0.0
MCP_PORT=8100
EMBEDDING_MODEL=intfloat/multilingual-e5-small
SEMANTIC_THRESHOLD=0.85
# Only the backend talks to Dify now (admin_api.py's /admin/chat and
# /admin/list-terms proxies) - default matches what tools/Caddyfile already
# proxies /v1/* to from the browser, since the MCP server runs on this same
# host (not in Docker). The actual app API keys live in .runtime/chatflow-
# key.txt / .runtime/list-terms-key.txt (written by scripts/publish_*.py),
# never in this file or the frontend.
DIFY_API_BASE_URL=http://localhost:80
# Which profile is active by default (no .runtime/llm_provider.json override yet):
# "openai" or "local". The admin UI's Settings screen switch overrides this at
# runtime without editing this file - see term_service/credentials.py.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Only needed if you'll use the local-model switch (see CLAUDE.md's "로컬 모델(Ollama) 테스트" section).
LOCAL_LLM_MODEL=qwen3-8b-q8
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
DEFINITION_CONFIDENCE_THRESHOLD=0.85
# TEST-ONLY - local provider only, never applied to OpenAI. Caps how many
# candidates registration.prepare() runs its duplicate-check compare() against
# so local testing fits inside Dify's 5-minute MCP tool timeout. Trades
# duplicate-detection coverage for speed - see CLAUDE.md's "로컬 모델(Ollama)
# 테스트" section before changing this.
LOCAL_COMPARE_CANDIDATE_CAP=5
